# vesc-dashboard: ESP-IDF 6.1 defaults for both boards (ESP32-C6 FireBeetle 2, ESP32-S3-Zero).
# These reproduce what the Arduino core used to set implicitly. The builder derives
# sdkconfig.<env> from this file; edit here, never in the generated file.
#
# No CONFIG_IDF_TARGET here: the target is the board JSON's build.mcu (esp32c6 for the FireBeetle,
# esp32s3 for the S3-Zero), which the builder passes as -DIDF_TARGET. ESP-IDF then also applies
# sdkconfig.defaults.<target> right after this file (sdkconfig.defaults.esp32s3).

# Flash: 4 MB, QIO, 80 MHz. The PlatformIO builder checks the size against boards/*.json.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table: partitions.csv in the project root (2 x 1.94 MB OTA app slots, coredump).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Over-the-air update (src/ota.cpp). A freshly written image runs on probation: unless it calls
# esp_ota_mark_app_valid_cancel_rollback() (after OTA_CONFIRM_MS with every task alive), the next
# boot goes back to the slot that worked. A panic, a watchdog reset or a power cycle before that
# point rolls back on its own. This is a BOOTLOADER option: it takes effect with a wired flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Wi-Fi only ever runs in update mode, while the upload erases flash sector by sector. Its hot
# paths must stay in IRAM (the IDF default) so the radio keeps working with the cache off, and the
# access point needs SoftAP support (default y as well); both are spelled out so nobody trims them.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# 1 ms tick (IDF default is 100 Hz): every pdMS_TO_TICKS() delay, the button debounce and the
# task heartbeats assume millisecond resolution.
CONFIG_FREERTOS_HZ=1000

# Console and ESP_LOG output over the USB-Serial/JTAG port (GPIO12/13). Output is dropped, never
# blocked, while no host is attached. UART0 (GPIO16/17) stays the ROM boot console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Runtime log level info. Debug lines of this project's own tags are enabled per build with
# -DLOG_LOCAL_LEVEL=ESP_LOG_DEBUG in platformio.ini (main.cpp raises those tags at boot).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# app_main() is the supervisor: it copies a SharedState snapshot and formats ~1 KB log lines.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Optimise for size like the Arduino build (-Os).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Core dumps into the coredump partition (ELF format).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
